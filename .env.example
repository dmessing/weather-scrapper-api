# NCDC (NOAA CDO v2) web service key — https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# Neon Postgres connection string (pooled endpoint is fine; the HTTP driver
# doesn't hold connections open).
NEON_POSTGRESS_CONN_STR=

# Per-consumer bearer tokens, comma-separated "name:token" pairs.
# Mint one with: npm run mint-token
CLIENT_TOKENS=fog-light:replace-me,rainhedge:replace-me

# NWS (api.weather.gov) rejects requests without a contact address here.
# Only needed once the forecast endpoint lands.
NWS_USER_AGENT=(noaa-precip, you@example.com)
